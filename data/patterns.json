      "revenue",
      "faturamento",
      "vendas",
      "sales",
      "despesa",
      "custo",
      "lucro",
      "prejuízo",
      "resultado",
      "receita operacional",
      "receita bruta",
      "receita líquida",
      "custo das vendas",
      "custo dos produtos vendidos",
      "cpv",
      "cmv",
      "despesas operacionais",
      "despesas administrativas",
      "despesas comerciais",
